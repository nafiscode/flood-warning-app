# Copy to .env.local and fill in. Never commit .env.local.
# Phase A0 adds the Supabase, VAPID, LINE and SMS variables here.

# Public project contact. Used in the User-Agent of data requests (ThaiWater) and shown
# as the project contact. Not a secret; scripts read it from here, never hardcode it.
CONTACT_EMAIL=jagaapp.th@gmail.com

# Optional: where the pipeline keeps its data, relative to pipeline/ (default: data, the jaga-data clone)
# JAGA_DATA_DIR=data
