# Copy to .env.local and fill in. Never commit .env.local, and never paste its values into a chat.
# Later phases add the SMS variables here.

# --- Supabase: the free dev project jaga-dev (SETUP.md, "One-time: the Supabase dev project")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only; bypasses RLS. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=
# Session pooler URI with the database password; for migrations and RLS tests only.
SUPABASE_DB_URL=
# The live project, once it exists: the same kind of address, for `npm run db:push:live`.
# It must differ from SUPABASE_DB_URL, and nothing can reset it (scripts/db.mjs refuses).
LIVE_DB_URL=

# --- Cloudflare R2: pipeline outputs (SETUP.md, "One-time: Cloudflare R2")
# Used only by pipeline/r2sync on the laptop; never in the web app or on Vercel.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# https://<account id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET_PUBLIC=jaga-tiles
R2_BUCKET_PRIVATE=jaga-rasters
# Public base URL of jaga-tiles: the r2.dev URL during development, https://tiles.<domain> before launch.
NEXT_PUBLIC_TILES_BASE_URL=
# Esri World Imagery for the map's satellite background (free ArcGIS Location Platform key,
# basemaps only, restricted to the site's own addresses; pay-as-you-go left off). Empty = EOX.
NEXT_PUBLIC_ARCGIS_API_KEY=
# The site's own address, once it has a domain (e.g. https://jagaapp.org). Used for the link and
# picture shown when Jaga is shared. Empty: Vercel's live address, or localhost.
NEXT_PUBLIC_SITE_URL=

# --- LINE: one provider "Jaga" holding both channels, so user IDs match (phase A2 sign-in, A6 alerts)
# LINE Login channel > Basic settings.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Messaging API channel of the LINE Official Account. Server only; the token can message every follower.
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# --- Google Earth Engine: Cloud project ID registered for non-commercial use (pipeline/sar_floods, phase S2)
# Not a secret. The sign-in itself lives outside the repo (earthengine authenticate).
EE_PROJECT=

# --- Launch switches (server only; all off by default)
# 1 once admins are issuing alerts (launch day). Until then a tambon without an alert shows
# "not in service yet", never Normal.
JAGA_IN_SERVICE=
# 1 lets the SOS and report flows send before launch. For the end-to-end tests only (they run a
# production build); never set it on a deployment: JAGA_IN_SERVICE is the real switch.
JAGA_SOS_SENDING_FOR_TESTS=
# 1 turns on donations and the Transparency tab (phase A11, owner's decision).
JAGA_DONATIONS=
# The project's own help line for the home screen, digits only. Empty: not shown.
NEXT_PUBLIC_PROJECT_LINE=

# Public project contact. Used in the User-Agent of data requests (ThaiWater) and shown
# as the project contact. Not a secret; scripts read it from here, never hardcode it.
CONTACT_EMAIL=jagaapp.th@gmail.com

# The addresses allowed to hold the super admin role, comma-separated, read by
# `npm run admin:super` (scripts/admin.mjs). Keep the real list in .env.local, not here: this
# repo is public. Unset means one super admin only, the rule before 16 Oct 2026.
SUPER_ADMIN_EMAILS=jagaapp.th@gmail.com

# Optional: where the pipeline keeps its data, relative to pipeline/ (default: data, the jaga-data clone)
# JAGA_DATA_DIR=data

# GISTDA open flood data (free key from api-gateway.gistda.or.th). Sent as an `API-Key` header, from
# the pipeline or the server only. Their answers repeat the key inside `links`: never log or forward one whole.
GISTDA_API_KEY=

# --- Web push (A7): the keys that sign what Jaga sends to phones. Make a pair once per site with
# `npx web-push generate-vapid-keys`. The public key goes to browsers; the private key must stay
# on the server (here and in Vercel's environment variables, never in the repo). Changing them
# silently ends every existing subscription. Sending also needs CONTACT_EMAIL above.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
